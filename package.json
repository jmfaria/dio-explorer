{
  "name": "dio-explorer-api",
  "version": "1.0.0",
  "description": "API REST do DIO Explorer — converte os slash commands /trilha, /certificado e /desafio em endpoints HTTP.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}
